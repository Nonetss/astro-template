---
import Main from '@/layouts/main.astro';
import { Button } from '@/components/ui/button';
import { ButtonLogOut } from '@/components/features/login/buttonLogOut';
const { user } = Astro.locals;
---

<Main title="Inicio">
  <div
    class="bg-background flex min-h-screen flex-col items-center justify-center px-6"
  >
    <div class="w-full max-w-lg text-center">
      <h1
        class="font-display text-foreground text-6xl leading-tight font-bold tracking-tight"
      >
        {user ? `Hola, ${user.name.split(' ')[0]}` : 'Bienvenido'}
      </h1>
      <p class="text-muted-foreground mt-5 text-base leading-relaxed">
        Template para proyectos Astro con React, TailwindCSS y Shadcn UI.
      </p>
      <div class="mt-10">
        {
          user ? (
            <div class="flex flex-col items-center justify-center gap-3">
              <Button className="w-full" variant="secondary">
                <a class="h-full" href="/components">
                  Components
                </a>
              </Button>
              <ButtonLogOut client:load />
            </div>
          ) : (
            <Button asChild className="px-8">
              <a href="/login">Iniciar sesión</a>
            </Button>
          )
        }
      </div>
    </div>
  </div>
</Main>
