---
import Main from '@/layouts/main.astro';
---

<Main title="404">
  <div
    class="bg-background flex min-h-screen flex-col items-center justify-center px-6 text-center"
  >
    <p
      class="font-display text-muted-foreground text-sm font-medium tracking-widest uppercase"
    >
      Error 404
    </p>
    <h1 class="font-display text-foreground mt-3 text-4xl font-bold">
      Página no encontrada
    </h1>
    <p class="text-muted-foreground mt-4 text-sm">
      La ruta que buscas no existe o fue eliminada.
    </p>
    <a
      href="/"
      class="text-primary mt-8 text-sm font-medium underline-offset-4 hover:underline"
    >
      Volver al inicio
    </a>
  </div>
</Main>
