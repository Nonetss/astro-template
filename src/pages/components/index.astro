---
import Main from '@/layouts/main.astro';
import PageHeader from '@/components/ui/page-header.astro';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Textarea } from '@/components/ui/textarea';
import { Checkbox } from '@/components/ui/checkbox';
import { Badge } from '@/components/ui/badge';
import { Separator } from '@/components/ui/separator';
import { AvatarWithFallback } from '@/components/ui/avatar-with-fallback';
import { SelectDemo } from '@/components/ui/select-demo';
import { AccordionDemo } from '@/components/ui/accordion-demo';
import { TabsDemo } from '@/components/ui/tabs-demo';
import { CalendarDemo } from '@/components/ui/calendar-demo';
import {
  Table,
  TableHeader,
  TableBody,
  TableRow,
  TableHead,
  TableCell,
} from '@/components/ui/table';
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
  CardFooter,
} from '@/components/ui/card';
---

<Main title="Componentes">
  <div class="bg-background min-h-screen px-8 py-16">
    <div class="mx-auto max-w-4xl space-y-20">
      <PageHeader
        title="Componentes"
        label="Design System"
        description="Vista previa del sistema de diseño. Solo para desarrollo."
      />

      <!-- Tipografía -->
      <section class="space-y-6">
        <h2
          class="font-display text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Tipografía
        </h2>
        <div class="space-y-4">
          <div>
            <p class="text-muted-foreground mb-1 text-xs">Display / Domine</p>
            <p
              class="font-display text-foreground text-5xl leading-tight font-bold"
            >
              El veloz murciélago
            </p>
          </div>
          <div>
            <p class="text-muted-foreground mb-1 text-xs">Heading 2</p>
            <p class="font-display text-foreground text-3xl font-semibold">
              hindú come feliz
            </p>
          </div>
          <div>
            <p class="text-muted-foreground mb-1 text-xs">Heading 3</p>
            <p class="font-display text-foreground text-xl font-semibold">
              kiwi y cigüeña
            </p>
          </div>
          <div>
            <p class="text-muted-foreground mb-1 text-xs">Body / Funnel Sans</p>
            <p class="text-foreground max-w-lg text-base leading-relaxed">
              El diseño de sistemas tipográficos requiere coherencia entre
              escala, peso y espaciado. Una buena jerarquía comunica estructura
              sin necesidad de color.
            </p>
          </div>
          <div>
            <p class="text-muted-foreground mb-1 text-xs">Small / Muted</p>
            <p class="text-muted-foreground text-sm">
              Texto auxiliar, descripciones y metadatos secundarios.
            </p>
          </div>
          <div>
            <p class="text-muted-foreground mb-1 text-xs">Label / Uppercase</p>
            <p
              class="text-muted-foreground text-xs font-medium tracking-widest uppercase"
            >
              Etiqueta de sección
            </p>
          </div>
        </div>
      </section>

      <!-- Colores -->
      <section class="space-y-6">
        <h2
          class="font-display text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Paleta
        </h2>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
          {
            [
              { name: 'Background', cls: 'bg-background border border-border' },
              { name: 'Card', cls: 'bg-card border border-border' },
              { name: 'Secondary', cls: 'bg-secondary' },
              { name: 'Muted', cls: 'bg-muted' },
              { name: 'Primary', cls: 'bg-primary' },
              { name: 'Destructive', cls: 'bg-destructive' },
              { name: 'Border', cls: 'bg-border' },
              { name: 'Foreground', cls: 'bg-foreground' },
            ].map(({ name, cls }) => (
              <div>
                <div class={`h-12 w-full ${cls}`} />
                <p class="text-muted-foreground mt-1.5 text-xs">{name}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Botones -->
      <section class="space-y-6">
        <h2
          class="font-display text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Botones
        </h2>
        <div class="flex flex-wrap gap-3">
          <Button>Default</Button>
          <Button variant="secondary">Secondary</Button>
          <Button variant="outline">Outline</Button>
          <Button variant="ghost">Ghost</Button>
          <Button variant="destructive">Destructive</Button>
          <Button variant="link">Link</Button>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button size="lg">Large</Button>
          <Button>Default</Button>
          <Button size="sm">Small</Button>
          <Button size="icon">+</Button>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button disabled>Disabled</Button>
          <Button variant="outline" disabled>Disabled outline</Button>
        </div>
      </section>

      <!-- Inputs -->
      <section class="space-y-6">
        <h2
          class="font-display text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Formulario
        </h2>
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="space-y-1.5">
            <Label>Email</Label>
            <Input
              type="email"
              placeholder="tu@email.com"
              className="rounded-none"
            />
          </div>
          <div class="space-y-1.5">
            <Label>Contraseña</Label>
            <Input
              type="password"
              placeholder="••••••••"
              className="rounded-none"
            />
          </div>
          <div class="space-y-1.5">
            <Label>Deshabilitado</Label>
            <Input
              placeholder="No editable"
              disabled
              className="rounded-none"
            />
          </div>
          <div class="space-y-1.5">
            <Label>Con valor</Label>
            <Input value="Valor existente" className="rounded-none" />
          </div>
        </div>
      </section>

      <!-- Cards -->
      <section class="space-y-6">
        <h2
          class="font-display text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Cards
        </h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <Card className="rounded-none">
            <CardHeader>
              <CardTitle>Título de la card</CardTitle>
              <CardDescription
                >Descripción secundaria con información de contexto.</CardDescription
              >
            </CardHeader>
            <CardContent>
              <p class="text-muted-foreground text-sm">
                Contenido principal de la card. Puede incluir cualquier
                elemento.
              </p>
            </CardContent>
            <CardFooter>
              <Button className="w-full">Acción</Button>
            </CardFooter>
          </Card>

          <Card className="rounded-none">
            <CardHeader>
              <CardTitle>Card sin footer</CardTitle>
              <CardDescription>Solo con header y contenido.</CardDescription>
            </CardHeader>
            <CardContent className="space-y-3">
              <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Estado</span>
                <span class="text-foreground font-medium">Activo</span>
              </div>
              <div class="bg-border h-px"></div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Última conexión</span>
                <span class="text-foreground font-medium">Hace 2h</span>
              </div>
              <div class="bg-border h-px"></div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Rol</span>
                <span class="text-foreground font-medium">Admin</span>
              </div>
            </CardContent>
          </Card>
        </div>
      </section>

      <!-- Estados de feedback -->
      <section class="space-y-6">
        <h2
          class="font-display text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Feedback
        </h2>
        <div class="space-y-3">
          <div
            class="border-border bg-card text-foreground border px-4 py-3 text-sm"
          >
            <span class="font-medium">Info</span> — Mensaje informativo neutral.
          </div>
          <div
            class="border-primary/40 bg-primary/10 text-foreground border px-4 py-3 text-sm"
          >
            <span class="text-primary font-medium">Éxito</span> — Operación completada
            correctamente.
          </div>
          <div
            class="border-destructive/40 bg-destructive/10 text-foreground border px-4 py-3 text-sm"
          >
            <span class="text-destructive font-medium">Error</span> — Algo ha ido
            mal. Inténtalo de nuevo.
          </div>
        </div>
      </section>

      <!-- Select -->
      <section class="space-y-6">
        <h2
          class="font-display text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Select
        </h2>
        <SelectDemo client:load />
      </section>

      <!-- Textarea -->
      <section class="space-y-6">
        <h2
          class="font-display text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Textarea
        </h2>
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="space-y-1.5">
            <Label>Descripción</Label>
            <Textarea
              placeholder="Escribí una descripción…"
              className="resize-none rounded-none"
              rows={4}
            />
          </div>
          <div class="space-y-1.5">
            <Label>Deshabilitado</Label>
            <Textarea
              placeholder="No editable"
              disabled
              className="resize-none rounded-none"
              rows={4}
            />
          </div>
        </div>
      </section>

      <!-- Checkbox -->
      <section class="space-y-6">
        <h2
          class="font-display text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Checkbox
        </h2>
        <div class="flex flex-col gap-3">
          <div class="flex items-center gap-2">
            <Checkbox id="check1" defaultChecked />
            <Label htmlFor="check1">Activo por defecto</Label>
          </div>
          <div class="flex items-center gap-2">
            <Checkbox id="check2" />
            <Label htmlFor="check2">Sin marcar</Label>
          </div>
          <div class="flex items-center gap-2">
            <Checkbox id="check3" disabled />
            <Label htmlFor="check3" className="text-muted-foreground"
              >Deshabilitado</Label
            >
          </div>
          <div class="flex items-center gap-2">
            <Checkbox id="check4" disabled defaultChecked />
            <Label htmlFor="check4" className="text-muted-foreground"
              >Deshabilitado marcado</Label
            >
          </div>
        </div>
      </section>

      <!-- Badge -->
      <section class="space-y-6">
        <h2
          class="font-display text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Badge
        </h2>
        <div class="flex flex-wrap gap-3">
          <Badge>Default</Badge>
          <Badge variant="secondary">Secondary</Badge>
          <Badge variant="outline">Outline</Badge>
          <Badge variant="destructive">Destructive</Badge>
        </div>
      </section>

      <!-- Avatar -->
      <section class="space-y-6">
        <h2
          class="font-display text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Avatar
        </h2>
        <div class="flex flex-wrap items-center gap-4">
          <AvatarWithFallback initials="MG" className="size-8" />
          <AvatarWithFallback initials="AB" className="size-10" />
          <AvatarWithFallback initials="XY" className="size-14" />
          <AvatarWithFallback initials="JD" className="size-20" />
        </div>
        <div class="flex items-center gap-3">
          <AvatarWithFallback initials="CR" className="size-10" />
          <div class="flex flex-col">
            <span class="text-foreground text-sm font-medium">Carlos Ruiz</span>
            <span class="text-muted-foreground text-xs"
              >Docente · Matemática</span
            >
          </div>
        </div>
      </section>

      <!-- Separator -->
      <section class="space-y-6">
        <h2
          class="font-display text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Separator
        </h2>
        <div class="space-y-4">
          <div class="flex flex-col gap-2">
            <p class="text-muted-foreground text-xs">Horizontal</p>
            <Separator />
          </div>
          <div class="flex h-8 items-center gap-4">
            <span class="text-foreground text-sm">Inicio</span>
            <Separator orientation="vertical" />
            <span class="text-foreground text-sm">Cursos</span>
            <Separator orientation="vertical" />
            <span class="text-foreground text-sm">Perfil</span>
          </div>
        </div>
      </section>

      <!-- Tabs -->
      <section class="space-y-6">
        <h2
          class="font-display text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Tabs
        </h2>
        <TabsDemo client:load />
      </section>

      <!-- Accordion -->
      <section class="space-y-6">
        <h2
          class="font-display text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Accordion
        </h2>
        <AccordionDemo client:load />
      </section>

      <!-- Tabla -->
      <section class="space-y-6">
        <h2
          class="font-display text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Tabla
        </h2>
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>Nombre</TableHead>
              <TableHead>Rol</TableHead>
              <TableHead>Curso</TableHead>
              <TableHead class="text-right">Estado</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {
              [
                {
                  name: 'Ana Gómez',
                  role: 'Estudiante',
                  course: 'Matemática II',
                  status: 'Activa',
                },
                {
                  name: 'Carlos Ruiz',
                  role: 'Docente',
                  course: 'Historia',
                  status: 'Activo',
                },
                {
                  name: 'Laura Perez',
                  role: 'Estudiante',
                  course: 'Biología',
                  status: 'Inactiva',
                },
                {
                  name: 'Martín López',
                  role: 'Admin',
                  course: '—',
                  status: 'Activo',
                },
              ].map((row) => (
                <TableRow>
                  <TableCell className="font-medium">{row.name}</TableCell>
                  <TableCell>{row.role}</TableCell>
                  <TableCell>{row.course}</TableCell>
                  <TableCell className="text-right">{row.status}</TableCell>
                </TableRow>
              ))
            }
          </TableBody>
        </Table>
      </section>

      <!-- Calendario -->
      <section class="space-y-6">
        <h2
          class="font-display text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Calendario
        </h2>
        <CalendarDemo client:load />
      </section>

      <!-- Footer -->
      <div class="border-border border-t pt-8 text-center">
        <p class="text-muted-foreground text-xs">
          <a href="/" class="hover:text-foreground transition-colors"
            >← Volver al inicio</a
          >
        </p>
      </div>
    </div>
  </div>
</Main>
